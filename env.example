# Server
PORT=5000
HOST=0.0.0.0

# Database
MONGO_URI=mongodb://localhost:27017/smart_vault

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Optional: default vault ID for GET /api/lock/status when ESP sends no query
# DEFAULT_VAULT_ID=507f1f77bcf86cd799439011

# --- Email (OTP, booking reminder, booking over) ---
# We have migrated to Nodemailer (e.g. Gmail SMTP) to ensure reliable delivery.
# If using Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
EMAIL_FROM="SmartVaultz <your-email@gmail.com>"

# Slot times (e.g. "9:00 AM - 9:30 AM") are interpreted in this timezone. Minutes ahead of UTC (IST = 330).
# Default 330 = Indian Standard Time (UTC+5:30). Reminder and "booking over" run at the correct local time.
SLOT_TIMEZONE_OFFSET_MINUTES=330

# Server
PORT=5000
HOST=0.0.0.0

# Database
MONGO_URI=mongodb://localhost:27017/smart_vault

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Optional: default vault ID for GET /api/lock/status when ESP sends no query
# DEFAULT_VAULT_ID=507f1f77bcf86cd799439011

# --- Email (OTP, booking reminder, booking over) – Resend only ---
# Same key is used for: OTP (signup/forgot password), "10 min left" reminder, and "booking over" emails.
# Use an address on your verified domain (resend.com/domains); otherwise Resend only allows sending to your own email.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=SmartVaultz <noreply@smartvault.online>

# If RESEND_API_KEY is not set, OTP is only logged to the server console; booking emails are skipped (bookings still get deleted when time is over).

# Slot times (e.g. "9:00 AM - 9:30 AM") are interpreted in this timezone. Minutes ahead of UTC (IST = 330).
# Default 330 = Indian Standard Time (UTC+5:30). Reminder and "booking over" run at the correct local time.
SLOT_TIMEZONE_OFFSET_MINUTES=330
